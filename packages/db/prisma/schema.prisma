generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Device {
  id               String             @id @db.Uuid
  deviceHash       String             @unique
  transferCode     String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  SafetyStatus     SafetyStatus?
  SiteStatusReport SiteStatusReport[]
  WatchRegion      WatchRegion[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EvacSite {
  id                       String                     @id @db.Uuid
  kind                     SiteKind
  sourceId                 String?                    @unique
  name                     String
  address                  String?
  latitude                 Float
  longitude                Float
  municipalityCode         String?
  capacity                 Int?
  isDesignated             Boolean                    @default(true)
  sourceName               String
  sourceUrl                String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  isActive                 Boolean                    @default(true)
  EvacSiteHazardCapability EvacSiteHazardCapability[]
  SafetyStatus             SafetyStatus[]
  SiteStatusReport         SiteStatusReport[]

  @@index([latitude, longitude])
  @@index([municipalityCode])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EvacSiteHazardCapability {
  id          String     @id @db.Uuid
  siteId      String     @db.Uuid
  hazardType  HazardType
  isSupported Boolean    @default(false)
  remark      String?
  EvacSite    EvacSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, hazardType])
  @@index([hazardType])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model HazardAlertSnapshot {
  id          String      @id @db.Uuid
  regionId    String      @db.Uuid
  hazardType  HazardType
  riskLevel   String
  checkedAt   DateTime    @default(now())
  WatchRegion WatchRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId, hazardType, checkedAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SafetyStatus {
  id                String      @id @db.Uuid
  deviceId          String      @unique @db.Uuid
  status            SafetyState
  currentSiteId     String?     @db.Uuid
  updatedAt         DateTime    @default(now())
  lastKnownLat      Float?
  lastKnownLon      Float?
  locationAccuracyM Float?
  message           String?
  messagePublic     Boolean     @default(false)
  deletedAt         DateTime?
  expiresAt         DateTime    @default(dbgenerated("(now() + '72:00:00'::interval)"))
  EvacSite          EvacSite?   @relation(fields: [currentSiteId], references: [id])
  Device            Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SiteStatusReport {
  id              String             @id @db.Uuid
  siteId          String             @db.Uuid
  deviceHash      String
  deviceId        String?            @db.Uuid
  congestionLevel CongestionLevel
  accessibility   AccessibilityLevel
  comment         String?
  reportedAt      DateTime           @default(now())
  conditionKind   SiteConditionKind  @default(ok)
  updatedAt       DateTime           @default(now())
  deletedAt       DateTime?
  expiresAt       DateTime           @default(dbgenerated("(now() + '7 days'::interval)"))
  Device          Device?            @relation(fields: [deviceId], references: [id])
  EvacSite        EvacSite           @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([deviceHash, reportedAt])
  @@index([deviceId])
  @@index([siteId, reportedAt])
  @@unique([siteId, deviceHash])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WatchRegion {
  id                  String                @id @db.Uuid
  deviceId            String                @db.Uuid
  label               String
  latitude            Float
  longitude           Float
  radiusKm            Float
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  HazardAlertSnapshot HazardAlertSnapshot[]
  Device              Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  WatchRegionHazard   WatchRegionHazard[]

  @@index([deviceId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WatchRegionHazard {
  id          String      @id @db.Uuid
  regionId    String      @db.Uuid
  hazardType  HazardType
  active      Boolean     @default(true)
  WatchRegion WatchRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, hazardType])
}

enum AccessibilityLevel {
  accessible
  blocked
  unknown
}

enum CongestionLevel {
  low
  normal
  high
}

enum HazardType {
  earthquake
  tsunami
  flood
  inland_flood
  typhoon
  landslide
  fire
  volcano
  storm_surge
}

enum SafetyState {
  safe
  minor_injury
  serious_injury
  isolated
  evacuating
  evacuated
}

enum SiteKind {
  shelter
  space
  other
}

enum SiteConditionKind {
  ok
  crowded
  very_crowded
  closed
  blocked
}
